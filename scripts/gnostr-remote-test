#!/usr/bin/env bash
set -x

RELAY_CSV_URL="https://raw.githubusercontent.com/permissionlesstech/bitchat/refs/heads/main/relays/online_relays_gps.csv"

pick_relay_from_csv() {
  local csv
  csv=$(curl -fsSL "$RELAY_CSV_URL" 2>/dev/null) || {
    echo "Failed to fetch relay CSV, using fallback" >&2
    return 1
  }

  # Normalize CSV relay entries:
  # - strip the header
  # - keep only the first column (relay host)
  # - prepend wss:// when no scheme is present
  # - strip trailing :443 (wss default)
  # - drop empty or localhost-looking entries
  local relays
  relays=$(printf '%s\n' "$csv" \
    | tail -n +2 \
    | cut -d, -f1 \
    | sed -E \
        -e 's/^[[:space:]]+//' \
        -e 's/[[:space:]]+$//' \
        -e 's/^(wss?:|https?:)//' \
        -e 's/^\/+//' \
        -e 's/:443$//' \
        -e '/^$/d' \
        -e '/^localhost/d' \
        -e '/^127\./d' \
        -e 's/^/wss:\/\//')

  if [[ -z "$relays" ]]; then
    echo "No valid relays found in CSV, using fallback" >&2
    return 1
  fi

  # Pick a random relay from the list.
  if command -v shuf >/dev/null 2>&1; then
    printf '%s\n' "$relays" | shuf -n 1
  elif command -v sort >/dev/null 2>&1 && sort --help 2>&1 | grep -q -- '-R'; then
    printf '%s\n' "$relays" | sort -R | head -n 1
  else
    local count
    count=$(printf '%s\n' "$relays" | wc -l | tr -d ' ')
    local idx=$((RANDOM % count + 1))
    printf '%s\n' "$relays" | sed -n "${idx}p"
  fi
}

echo "gnostr-remote-test file name: $0"
echo "--- System Information ---"
echo "Hostname: $(hostname)"
echo "OS/Kernel: $(uname -a)"
if [[ "$(uname -s)" == "Linux" ]]; then
  echo "CPU Model: $(grep -m 1 'model name' /proc/cpuinfo 2>/dev/null | cut -d: -f2 | sed 's/^[ \t]*//')"
  echo "Total Memory: $(free -h 2>/dev/null | awk '/^Mem:/ {print $2}')"
else
  echo "CPU Model: $(sysctl -n machdep.cpu.brand_string 2>/dev/null || echo 'unknown')"
  echo "Total Memory: $(sysctl -n hw.memsize 2>/dev/null | awk '{printf "%.0f MiB\n", $1/1024/1024}')"
fi
echo "Current User: $(whoami)"
echo "Current Directory: $(pwd)"
echo ""
echo "--- Script Information ---"
echo "Script PID: $$"
echo "hello, gnostr-remote-test!"

gnostr="${GNOSTR_BIN:-./target/debug/gnostr}"
export gnostr

if [[ ! -x "$gnostr" ]]; then
  echo "gnostr binary not found or not executable: $gnostr" >&2
  exit 1
fi

HASH=$($gnostr --hash "")
NSEC=${1:-$HASH}

if [[ -n "${2:-}" ]]; then
  RELAY=$2
else
  RELAY=$(pick_relay_from_csv || echo "wss://relay.damus.io")
fi
echo "Using relay: $RELAY"

export EVENT1=$($gnostr --nsec "$NSEC" -r "$RELAY" custom-event -k 30617 -c "" \
  -t "a|30617" -t "d|gnostr" -t "name|gnostr" -t "description|a git+nostr workflow utilty" \
  -t "web|git.gnostr.org" -t "clone|git.gnostr.org" \
  -t "relays|wss://relay.damus.io, wss://relay.gnostr.org" -t "r|<earliest_unique_commit>" \
  -t "maintainers|gnostr <admin@gnostr.org>" \
  -t "t|this_is_a_test_PoC_of_adistributed_decentralized_CI_service" \
  -t "weeble|$($gnostr --weeble)" -t "blockheight|$($gnostr --blockheight)" \
  -t "wobble|$($gnostr --wobble)")
EVENT1_ID=$($gnostr bech32-to-any "$EVENT1" --raw)

echo "$EVENT1_ID"
$gnostr fetch-by-id -i "$EVENT1_ID" --relay "$RELAY"

echo
sleep 2

export EVENT2=$($gnostr --nsec "$NSEC" -r "$RELAY" custom-event -k 1 \
  -c "#gnostr distributed/decentralized CI EVENT! REF:https://nostr.band/?q=$EVENT1_ID" \
  -t "a|30617" -t "d|gnostr" -t "name|gnostr" -t "description|a git+nostr workflow utilty" \
  -t "web|git.gnostr.org" -t "clone|git.gnostr.org" \
  -t "relays|wss://relay.damus.io, wss://relay.gnostr.org" -t "r|<earliest_unique_commit>" \
  -t "maintainers|gnostr <admin@gnostr.org>" \
  -t "t|this_is_a_test_PoC_of_adistributed_decentralized_CI_service" \
  -t "weeble|$($gnostr --weeble)" -t "blockheight|$($gnostr --blockheight)" \
  -t "wobble|$($gnostr --wobble)")
export EVENT2_ID=$($gnostr bech32-to-any "$EVENT2" --raw)
$gnostr fetch-by-id -i "$EVENT2_ID" -r "$RELAY"

echo
sleep 2

# Give the relay time to make EVENT2 available before reacting.
sleep 2

$gnostr --nsec "$($gnostr privkey-to-bech32 "$NSEC")" -r "$RELAY" react -e "$EVENT1_ID" --reaction "$EVENT2_ID"
$gnostr --nsec "$($gnostr privkey-to-bech32 "$NSEC")" -r "$RELAY" react -e "$EVENT2_ID" --reaction "$EVENT1_ID"

# a known event 8bd85322d47f896c1cc4b20887b08513a0c6065b997debe7f4e87cc949ee7686 to test
$gnostr --nsec "$NSEC" -r "$RELAY" react -e 8bd85322d47f896c1cc4b20887b08513a0c6065b997debe7f4e87cc949ee7686 -r "$EVENT1_ID"
$gnostr --nsec "$NSEC" -r "$RELAY" react -e 8bd85322d47f896c1cc4b20887b08513a0c6065b997debe7f4e87cc949ee7686 -r "$EVENT2_ID"
