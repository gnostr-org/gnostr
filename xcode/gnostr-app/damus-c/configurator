#!/bin/sh
set -eu
set -f

if [ "$#" -lt 1 ]; then
    echo "Usage: sh damus-c/configurator OUTPUT_HEADER [COMPILER_FLAGS...]" >&2
    exit 2
fi

output=$1
shift
cc=${CC:-cc}
mkdir -p "$(dirname "$output")"
temporary=$(mktemp -d "$(dirname "$output")/.configurator.XXXXXX")
trap 'rm -f "$temporary/probe.c" "$temporary/probe.o" "$temporary/probe.log" "$temporary/config.h"; rmdir "$temporary"' EXIT
trap 'exit 1' HUP INT TERM

compile()
{
    architecture=$1
    shift
    set -- "$cc" "$@" -std=gnu11 -Werror -Werror=unguarded-availability \
        -c "$temporary/probe.c" -o "$temporary/probe.o"
    if [ -n "${SDKROOT:-}" ]; then
        set -- "$@" -isysroot "$SDKROOT"
    fi
    if [ "$architecture" != native ]; then
        set -- "$@" -arch "$architecture"
    fi
    case "${PLATFORM_NAME:-}" in
        iphoneos)
            set -- "$@" "-miphoneos-version-min=${IPHONEOS_DEPLOYMENT_TARGET:-15.0}" ;;
        iphonesimulator)
            set -- "$@" "-mios-simulator-version-min=${IPHONEOS_DEPLOYMENT_TARGET:-15.0}" ;;
        macosx)
            set -- "$@" "-mmacosx-version-min=${MACOSX_DEPLOYMENT_TARGET:-12.3}" ;;
    esac
    "$@" > "$temporary/probe.log" 2>&1
}

probe()
{
    feature=$1
    source=$2
    shift 2
    printf '%s\n' "$source" > "$temporary/probe.c"
    available=1
    for architecture in ${ARCHS:-native}; do
        if ! compile "$architecture" "$@"; then
            available=0
            echo "--- $feature unavailable ($architecture) ---" >&2
            cat "$temporary/probe.log" >&2
            break
        fi
    done
    printf '#define %s %s\n' "$feature" "$available" >> "$temporary/config.h"
    printf '%s = %s\n' "$feature" "$available"
}

echo "========== Configuring damus-c =========="
printf 'Compiler: %s\nSDK: %s\nArchitectures: %s\n' \
    "$cc" "${SDKROOT:-default}" "${ARCHS:-native}"
printf 'int main(void) { return 0; }\n' > "$temporary/probe.c"
for architecture in ${ARCHS:-native}; do
    if ! compile "$architecture" "$@"; then
        cat "$temporary/probe.log" >&2
        echo "error: damus-c configurator cannot compile for $architecture" >&2
        exit 1
    fi
done

cat > "$temporary/config.h" <<'HEADER'
/* Generated by damus-c/configurator. Do not edit. */
#ifndef DAMUS_C_GENERATED_CONFIG_H
#define DAMUS_C_GENERATED_CONFIG_H
HEADER

probe HAVE_ALIGNOF 'int probe[__alignof__(long) > 0 ? 1 : -1];' "$@"
probe HAVE_TYPEOF 'int value; __typeof__(value) other;' "$@"
probe HAVE_STATEMENT_EXPR 'int probe(void) { return ({ int value = 1; value; }); }' "$@"

for attribute in cold const deprecated nonnull noreturn pure returns_nonnull sentinel unused used; do
    feature=$(printf '%s' "$attribute" | tr '[:lower:]' '[:upper:]')
    probe "HAVE_ATTRIBUTE_$feature" "
#if !__has_attribute($attribute)
#error Attribute unavailable
#endif
int probe;" "$@"
done
probe HAVE_ATTRIBUTE_PRINTF '
#if !__has_attribute(format)
#error Format attribute unavailable
#endif
int probe;' "$@"
probe HAVE_WARN_UNUSED_RESULT '
#if !__has_attribute(warn_unused_result)
#error Warn-unused-result attribute unavailable
#endif
int probe;' "$@"

probe HAVE_BUILTIN_CHOOSE_EXPR 'int probe = __builtin_choose_expr(1, 1, 0);' "$@"
probe HAVE_BUILTIN_CONSTANT_P 'int probe = __builtin_constant_p(1);' "$@"
probe HAVE_BUILTIN_EXPECT 'int probe(int n) { return __builtin_expect(n, 0); }' "$@"
probe HAVE_BUILTIN_TYPES_COMPATIBLE_P 'int probe = __builtin_types_compatible_p(int, int);' "$@"
probe HAVE_BYTESWAP_H '#include <byteswap.h>' "$@"
probe HAVE_BSWAP_64 '#include <byteswap.h>
unsigned long long probe(unsigned long long n) { return bswap_64(n); }' "$@"
probe HAVE_ISBLANK '#include <ctype.h>
int probe(int c) { return isblank(c); }' "$@"
probe HAVE_MEMMEM '#include <string.h>
void *probe(const void *p, size_t n) { return memmem(p, n, p, n); }' "$@"
probe HAVE_MEMRCHR '#include <string.h>
void *probe(const void *p, size_t n) { return memrchr(p, 0, n); }' "$@"
probe HAVE_VALGRIND_MEMCHECK_H '#include <valgrind/memcheck.h>' "$@"

cat >> "$temporary/config.h" <<'HEADER'

/* These properties must follow each compilation's architecture, not the host. */
#if defined(__has_builtin)
#define HAVE_BUILTIN_CPU_SUPPORTS __has_builtin(__builtin_cpu_supports)
#else
#define HAVE_BUILTIN_CPU_SUPPORTS 0
#endif

/* Aligned loads avoid undefined behavior in the SHA-256 implementation. */
#define HAVE_UNALIGNED_ACCESS 0

#if __BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__
#define HAVE_LITTLE_ENDIAN 1
#define HAVE_BIG_ENDIAN 0
#elif __BYTE_ORDER__ == __ORDER_BIG_ENDIAN__
#define HAVE_LITTLE_ENDIAN 0
#define HAVE_BIG_ENDIAN 1
#else
#error "Unsupported byte order"
#endif

#endif /* DAMUS_C_GENERATED_CONFIG_H */
HEADER

mv "$temporary/config.h" "$output"
echo "========== damus-c configuration complete: $output =========="
