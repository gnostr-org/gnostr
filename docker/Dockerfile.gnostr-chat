FROM rust:latest AS build
WORKDIR /app
RUN apt-get update && apt-get install -y \
    build-essential \
    golang-go \
    clang \
    libclang-dev \
    llvm-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*
COPY . .
RUN cargo build -p gnostr-bins --features chat --release -j4
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=build /app/target/release/gnostr-chat /usr/local/bin/gnostr-chat
ENTRYPOINT ["gnostr-chat"]
CMD ["--headless", "--topic", "gnostr-dev"]
